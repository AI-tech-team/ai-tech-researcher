# ⚠️ Vercel CLI は .gitignore を「ルールの供給源」として読まない（既定除外のファイル名リストに
# 入っているだけ）。ここに書かない限り、.env 系はデプロイのソースとして Vercel にアップロードされ、
# 過去デプロイに残り続ける（env変数と違いローテートしても消えない）。
.env*
!.env.example

# 週次DBバックアップ（262MB・リポジトリには入るがデプロイには不要）
v2/backups
# 会員データの暗号化バックアップ（ローカルのみ・絶対にアップロードしない）
v2/private-backups
# 旧試作・未使用
web
ops

# ローカルの退避ビルド。OneDrive が .next のハンドルを掴んで unlink できないとき（EPERM）に
# mv して残るもので、1個あたり 230〜260MB ある。⚠ Vercel CLI の既定除外は `.next` だけなので
# ここに書かないと**全部アップロードされ、3GB超で "Upload aborted" になる**（2026-09-12 実際に失敗）。
v2/.next-stale-*
v2/.next.old.*

# 実機確認用のスクリーンショット（デプロイには不要）
.screenshots
v2/.screenshots
